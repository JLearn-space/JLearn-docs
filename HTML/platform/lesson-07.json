    "starter_code": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Анкета участника</title>\n</head>\n<body>\n    <main>\n        <h1>Анкета участника</h1>\n        <form method=\"get\">\n            <!-- fieldset + legend «Личные данные»: номер билета (pattern 7 цифр, required), textarea «О себе» -->\n            <!-- fieldset + legend «Направление»: select с двумя optgroup и selected -->\n            <!-- button type=\"submit\" и button type=\"reset\" -->\n        </form>\n    </main>\n</body>\n</html>\n",
