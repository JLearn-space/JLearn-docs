    "hints": [
      "Группа: <fieldset><legend>Личные данные</legend> ... </fieldset>.",
      "Номер билета: pattern=\"[0-9]{7}\" и required.",
      "Начальный текст textarea - между тегами: <textarea>Текст</textarea>.",
      "Список: <select> с <optgroup label=\"...\"> и одним <option selected>.",
      "Кнопки: <button type=\"submit\"> и <button type=\"reset\">."
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Анкета участника</title>\n</head>\n<body>\n    <main>\n        <h1>Анкета участника</h1>\n        <form method=\"get\">\n            <fieldset>\n                <legend>Личные данные</legend>\n                <p>\n                    <label for=\"student-id\">Номер билета (7 цифр)</label>\n                    <input type=\"text\" id=\"student-id\" name=\"student-id\" pattern=\"[0-9]{7}\" inputmode=\"numeric\" required>\n                </p>\n                <p>\n                    <label for=\"about\">О себе</label>\n                    <textarea id=\"about\" name=\"about\" rows=\"4\" maxlength=\"300\">Учусь на первом курсе.</textarea>\n                </p>\n            </fieldset>\n            <fieldset>\n                <legend>Направление</legend>\n                <p>\n                    <label for=\"course\">Что хотите изучать</label>\n                    <select id=\"course\" name=\"course\">\n                        <optgroup label=\"Фронтенд\">\n                            <option value=\"html\" selected>HTML</option>\n                            <option value=\"css\">CSS</option>\n                        </optgroup>\n                        <optgroup label=\"Бэкенд\">\n                            <option value=\"php\">PHP</option>\n                            <option value=\"sql\">SQL</option>\n                        </optgroup>\n                    </select>\n                </p>\n            </fieldset>\n            <p>\n                <button type=\"submit\">Отправить анкету</button>\n                <button type=\"reset\">Сбросить</button>\n            </p>\n        </form>\n    </main>\n</body>\n</html>",
