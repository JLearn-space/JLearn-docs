  "task": {
    "title": "Participant form",
    "language": "html",
    "description": "A form with method=\"get\": two fieldsets with legend; the card number is required, exactly 7 digits (pattern); a textarea with initial text; a select with two optgroups and selected; every field has label for = id; buttons button type=\"submit\" and type=\"reset\".",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Participant form</title>\n</head>\n<body>\n    <main>\n        <h1>Participant form</h1>\n        <form method=\"get\">\n            <!-- fieldset + legend \"Personal details\": card number (pattern 7 digits, required), textarea \"About me\" -->\n            <!-- fieldset + legend \"Track\": select with two optgroups and selected -->\n            <!-- button type=\"submit\" and button type=\"reset\" -->\n        </form>\n    </main>\n</body>\n</html>\n",
    "rules": {
      "required": [
        "<!DOCTYPE html>",
        "<html lang=\"",
        "<meta charset=\"utf-8\"",
        "<form",
        "method=\"get\"",
        "<select",
        "<optgroup",
        "selected",
        "</textarea>",
        "pattern=\"",
        "{7}",
        "required",
        "type=\"reset\""
      ],
      "tags": {
        "fieldset": 2,
        "legend": 2,
        "optgroup": 2,
        "option": 3,
        "textarea": 1,
        "label": 3,
        "button": 2
      },
      "for_id_pairs": true,
      "button_submit": true,
      "h1_exact": 1
    },
    "hints": [
      "Group: <fieldset><legend>Personal details</legend> ... </fieldset>.",
      "Card number: pattern=\"[0-9]{7}\" and required.",
      "The initial text of a textarea goes between the tags: <textarea>Text</textarea>.",
      "List: <select> with <optgroup label=\"...\"> and one <option selected>.",
      "Buttons: <button type=\"submit\"> and <button type=\"reset\">."
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Participant form</title>\n</head>\n<body>\n    <main>\n        <h1>Participant form</h1>\n        <form method=\"get\">\n            <fieldset>\n                <legend>Personal details</legend>\n                <p>\n                    <label for=\"student-id\">Student card number (7 digits)</label>\n                    <input type=\"text\" id=\"student-id\" name=\"student-id\" pattern=\"[0-9]{7}\" inputmode=\"numeric\" required>\n                </p>\n                <p>\n                    <label for=\"about\">About me</label>\n                    <textarea id=\"about\" name=\"about\" rows=\"4\" maxlength=\"300\">I am a first-year student.</textarea>\n                </p>\n            </fieldset>\n            <fieldset>\n                <legend>Track</legend>\n                <p>\n                    <label for=\"course\">What do you want to learn</label>\n                    <select id=\"course\" name=\"course\">\n                        <optgroup label=\"Frontend\">\n                            <option value=\"html\" selected>HTML</option>\n                            <option value=\"css\">CSS</option>\n                        </optgroup>\n                        <optgroup label=\"Backend\">\n                            <option value=\"php\">PHP</option>\n                            <option value=\"sql\">SQL</option>\n                        </optgroup>\n                    </select>\n                </p>\n            </fieldset>\n            <p>\n                <button type=\"submit\">Submit the form</button>\n                <button type=\"reset\">Reset</button>\n            </p>\n        </form>\n    </main>\n</body>\n</html>",
