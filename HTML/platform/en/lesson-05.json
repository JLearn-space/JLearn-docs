        "row"
      ],
      "h1_exact": 1
    },
    "hints": [
      "Table name: <caption> right after <table>.",
      "Header row: <thead><tr><th scope=\"col\">Day</th>...</tr></thead>.",
      "Data row: <tr><th scope=\"row\">Monday</th><td>15:00</td><td>HTML</td></tr>.",
      "Second table: one <td rowspan=\"2\"> cell, the next row has one cell fewer.",
      "A header is <th>, not <td><strong>."
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Club schedule</title>\n</head>\n<body>\n    <main>\n        <h1>Club schedule</h1>\n        <table>\n            <caption>Classes for the week</caption>\n            <thead>\n                <tr>\n                    <th scope=\"col\">Day</th>\n                    <th scope=\"col\">Time</th>\n                    <th scope=\"col\">Topic</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <th scope=\"row\">Monday</th>\n                    <td>15:00</td>\n                    <td>HTML</td>\n                </tr>\n                <tr>\n                    <th scope=\"row\">Wednesday</th>\n                    <td>15:00</td>\n                    <td>Tables</td>\n                </tr>\n                <tr>\n                    <th scope=\"row\">Friday</th>\n                    <td>16:00</td>\n                    <td>Forms</td>\n                </tr>\n            </tbody>\n        </table>\n        <table>\n            <caption>Long class</caption>\n            <tr>\n                <th scope=\"col\">Time</th>\n                <th scope=\"col\">Class</th>\n            </tr>\n            <tr>\n                <td>10:00</td>\n                <td rowspan=\"2\">Project</td>\n            </tr>\n            <tr>\n                <td>11:00</td>\n            </tr>\n        </table>\n    </main>\n</body>\n</html>",
