        "answer": 2,
        "explanation": "The text should explain where the link leads."
      },
      {
        "type": "multiple",
        "question": "What do you need to jump to a section on the same page?",
        "options": [
          "An id on the target element",
          "href=\"#name\" on the link",
          "target=\"_blank\"",
          "rel=\"noopener\""
        ],
        "answer": [
          0,
          1
        ],
        "explanation": "Anchor = id on the target + a link with # and the same name."
