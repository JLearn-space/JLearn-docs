  "lesson_title": "Links and navigation",
  "task": {
    "title": "Club home page",
    "language": "html",
    "description": "Make the club's index.html: a nav menu to index.html, schedule.html, contacts.html; a table of contents with anchors #about and #join; h2 sections with these ids; in the \"How to join\" section - mailto:, tel: (no spaces, with +) and an external https link in a new tab with rel=\"noopener noreferrer\".",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Home - Club</title>\n</head>\n<body>\n    <header>\n        <p>Web development club</p>\n        <!-- nav: links to index.html, schedule.html, contacts.html -->\n    </header>\n    <main>\n        <h1>Welcome to the club</h1>\n        <!-- contents: links #about and #join -->\n\n        <!-- section h2 id=\"about\" -->\n\n        <!-- section h2 id=\"join\": mailto, tel, external link in a new tab -->\n    </main>\n</body>\n</html>\n",
    "rules": {
      "required": [
        "<!DOCTYPE html>",
        "<html lang=\"",
        "<meta charset=\"utf-8\"",
        "<title>",
        "<nav",
        "</nav>",
        "id=\"about\"",
        "id=\"join\"",
        "href=\"mailto:",
        "href=\"tel:+",
        "href=\"https://",
        "target=\"_blank\"",
        "rel=\"noopener"
      ],
      "forbidden": [
        "href=\"c:",
        "file://",
        "tel:+998 ",
        "<table"
      ],
      "href_targets": [
        "index.html",
        "schedule.html",
        "contacts.html",
        "#about",
        "#join"
      ],
      "h1_exact": 1,
      "h2_required": 2
    },
    "hints": [
      "Menu: <nav><ul><li><a href=\"index.html\">...</a></li>...</ul></nav>.",
      "Anchor: <h2 id=\"about\"> and the link <a href=\"#about\">.",
      "The phone in href has no spaces: href=\"tel:+998901112233\".",
      "External link: href=\"https://...\", target=\"_blank\", rel=\"noopener noreferrer\".",
      "Disk paths (C:\\...) and tables are not used."
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Home - Web development club</title>\n</head>\n<body>\n    <header>\n        <p>Web development club</p>\n        <nav>\n            <ul>\n                <li><a href=\"index.html\">Home</a></li>\n                <li><a href=\"schedule.html\">Schedule</a></li>\n                <li><a href=\"contacts.html\">Contacts</a></li>\n            </ul>\n        </nav>\n    </header>\n    <main>\n        <h1>Welcome to the club</h1>\n        <ul>\n            <li><a href=\"#about\">About the club</a></li>\n            <li><a href=\"#join\">How to join</a></li>\n        </ul>\n        <section>\n            <h2 id=\"about\">About the club</h2>\n            <p>We learn to build websites from scratch.</p>\n        </section>\n        <section>\n            <h2 id=\"join\">How to join</h2>\n            <p>Email: <a href=\"mailto:club@example.com\">club@example.com</a></p>\n            <p>Phone: <a href=\"tel:+998901112233\">+998 90 111-22-33</a></p>\n            <p><a href=\"https://developer.mozilla.org\" target=\"_blank\" rel=\"noopener noreferrer\">MDN reference (new tab)</a></p>\n        </section>\n    </main>\n</body>\n</html>",
