  "test": {
    "pass_percent": 70,
    "questions": [
      {
        "type": "single",
        "question": "Which attribute sets the link address?",
        "options": [
          "src",
          "href",
          "link",
          "url"
        ],
        "answer": 1,
        "explanation": "href means hypertext reference, the link address."
      },
      {
        "type": "single",
        "question": "A file is in the pages/ folder. How does it link to index.html in the project root?",
        "options": [
          "index.html",
          "/pages/index.html",
          "../index.html",
          "pages/index.html"
        ],
        "answer": 2,
        "explanation": "../ goes up one folder."
      },
      {
        "type": "single",
        "question": "How do you write a phone link correctly?",
        "options": [
          "href=\"+998901112233\"",
          "href=\"tel:+998901112233\"",
          "href=\"tel:+998 90 111 22 33\"",
          "href=\"phone:998901112233\""
        ],
        "answer": 1,
        "explanation": "The tel: prefix and the number without spaces, with the country code."
      },
      {
        "type": "single",
        "question": "Which link text is best?",
        "options": [
          "Click here",
          "Link",
