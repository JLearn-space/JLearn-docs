{
  "lesson": 10,
  "language": "en",
  "lesson_title": "Final project",
  "task": {
    "title": "The contacts page of your own site",
    "language": "html",
    "description": "Make contact.html for your own club, study group or library (not Aziz's portfolio): a complete head with viewport and description; a #main link and main id=\"main\"; a header with a menu to index.html, about.html, projects.html, contact.html; one h1; a table with caption and scope col/row; a form with method=\"get\", fieldset, legend, two labelled fields (one email) and button type=\"submit\"; footer.",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <!-- viewport, title, description -->\n</head>\n<body>\n    <!-- \"Skip to main content\" link -->\n    <!-- header with a menu: index.html, about.html, projects.html, contact.html -->\n    <!-- main id=\"main\": h1, table (caption, scope col and row), form (fieldset, legend, 2 fields with label, one email, button submit) -->\n    <!-- footer -->\n</body>\n</html>\n",
    "rules": {
      "required": [
        "<!DOCTYPE html>",
        "<html lang=\"",
        "<meta charset=\"utf-8\"",
        "name=\"viewport\"",
        "name=\"description\"",
        "<title>",
        "<header",
        "<nav",
        "<footer",
        "id=\"main\"",
        "<caption",
        "<fieldset",
        "<legend",
        "method=\"get\""
      ],
      "forbidden": [
        "<div",
        "role=\"button\"",
        "tabindex=\"1\"",
        "tabindex=\"2\"",
        "tabindex=\"3\"",
        "href=\"c:",
        "Азиз",
        "aziz"
      ],
      "tags": {
        "table": 1,
        "th": 3,
        "label": 2,
        "input": 2,
        "li": 4
      },
      "href_targets": [
        "#main",
        "index.html",
        "about.html",
        "projects.html",
        "contact.html"
      ],
      "scope_values": [
        "col",
        "row"
      ],
      "input_types": [
        "email"
      ],
      "for_id_pairs": true,
      "button_submit": true,
      "h1_exact": 1
    },
    "hints": [
      "In head: charset, viewport, your own title and description.",
      "The first line of body: <a href=\"#main\">Skip to main content</a>; main gets id=\"main\".",
      "A menu of 4 pages: index.html, about.html, projects.html, contact.html.",
      "Table: caption, th scope=\"col\" in the header row, th scope=\"row\" at the start of rows.",
      "Form: method=\"get\", fieldset + legend, label for = id, type=\"email\", <button type=\"submit\">.",
      "Your own topic: a club, study group, library. Do not copy the sample text."
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Contacts - Rook Chess Club</title>\n    <meta name=\"description\" content=\"How to contact Rook Chess Club: opening hours, phone and a sign-up form for a trial class.\">\n</head>\n<body>\n    <a href=\"#main\">Skip to main content</a>\n    <header>\n        <p>Rook Chess Club</p>\n        <nav>\n            <ul>\n                <li><a href=\"index.html\">Home</a></li>\n                <li><a href=\"about.html\">About the club</a></li>\n                <li><a href=\"projects.html\">Tournaments</a></li>\n                <li><a href=\"contact.html\">Contacts</a></li>\n            </ul>\n        </nav>\n    </header>\n    <main id=\"main\">\n        <h1>Contacts</h1>\n        <table>\n            <caption>Club opening hours</caption>\n            <thead>\n                <tr>\n                    <th scope=\"col\">Day</th>\n                    <th scope=\"col\">Time</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <th scope=\"row\">Tuesday</th>\n                    <td>16:00-19:00</td>\n                </tr>\n                <tr>\n                    <th scope=\"row\">Saturday</th>\n                    <td>10:00-14:00</td>\n                </tr>\n            </tbody>\n        </table>\n        <section>\n            <h2>Sign up for a trial class</h2>\n            <p>Practice form: the data appears in the page address and is not sent anywhere.</p>\n            <form method=\"get\">\n                <fieldset>\n                    <legend>Your details</legend>\n                    <p>\n                        <label for=\"name\">Name</label>\n                        <input type=\"text\" id=\"name\" name=\"name\" required>\n                    </p>\n                    <p>\n                        <label for=\"email\">Email</label>\n                        <input type=\"email\" id=\"email\" name=\"email\" required>\n                    </p>\n                </fieldset>\n                <p><button type=\"submit\">Sign up</button></p>\n            </form>\n        </section>\n    </main>\n    <footer>\n        <p><small>&copy; 2026 Rook Chess Club</small></p>\n    </footer>\n</body>\n</html>",
    "wrong_solutions": [
