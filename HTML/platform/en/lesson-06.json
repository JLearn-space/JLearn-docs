    "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Club sign-up</title>\n</head>\n<body>\n    <main>\n        <h1>Club sign-up</h1>\n        <form method=\"get\">\n            <p>\n                <label for=\"name\">Name</label>\n                <input type=\"text\" id=\"name\" name=\"name\" autocomplete=\"name\" required>\n            </p>\n            <p>\n                <label for=\"email\">Email</label>\n                <input type=\"email\" id=\"email\" name=\"email\" autocomplete=\"email\" required>\n            </p>\n            <p>\n                <label for=\"start\">Start date</label>\n                <input type=\"date\" id=\"start\" name=\"start\">\n            </p>\n            <p>\n                <input type=\"checkbox\" id=\"topic-html\" name=\"topics\" value=\"html\">\n                <label for=\"topic-html\">HTML</label>\n                <input type=\"checkbox\" id=\"topic-css\" name=\"topics\" value=\"css\">\n                <label for=\"topic-css\">CSS</label>\n            </p>\n            <p>\n                <input type=\"radio\" id=\"morning\" name=\"time\" value=\"morning\">\n                <label for=\"morning\">Morning</label>\n                <input type=\"radio\" id=\"evening\" name=\"time\" value=\"evening\">\n                <label for=\"evening\">Evening</label>\n            </p>\n            <p>\n                <input type=\"submit\" value=\"Sign up\">\n            </p>\n        </form>\n    </main>\n</body>\n</html>",
