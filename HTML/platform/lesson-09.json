  "lesson_title": "Мета-теги, SEO, связь с CSS и JS",
  "task": {
    "title": "Полный head главной страницы",
    "language": "html",
    "description": "Допишите head: viewport (width=device-width), description, og:title и og:description, иконку rel=\"icon\", стили css/style.css через link rel=\"stylesheet\", скрипт js/main.js с defer и закрывающим </script>. Тег <style> не используйте.",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Главная - Кружок веб-разработки</title>\n    <!-- viewport -->\n    <!-- description -->\n    <!-- og:title и og:description -->\n    <!-- иконка сайта -->\n    <!-- стили css/style.css -->\n    <!-- скрипт js/main.js с defer -->\n</head>\n<body>\n    <header>\n        <p>Кружок веб-разработки</p>\n    </header>\n    <main>\n        <h1>Добро пожаловать в кружок</h1>\n        <p>Учимся делать сайты с нуля.</p>\n    </main>\n    <footer>\n        <p><small>&copy; 2026 Кружок веб-разработки</small></p>\n    </footer>\n</body>\n</html>\n",
    "rules": {
      "required": [
        "<!DOCTYPE html>",
        "<html lang=\"",
        "<meta charset=\"utf-8\"",
        "name=\"viewport\"",
        "width=device-width",
        "name=\"description\"",
        "property=\"og:title\"",
        "property=\"og:description\"",
        "rel=\"icon\"",
        "rel=\"stylesheet\"",
        "href=\"css/style.css\"",
        "src=\"js/main.js\"",
        "defer",
        "</script>",
        "<header",
        "<main",
        "<footer"
      ],
      "forbidden": [
        "<style",
        "rel=\"style\"",
        "href=\"../css/style.css\""
      ],
      "tags": {
        "meta": 5,
        "link": 2,
        "script": 1,
        "title": 1
      },
      "attrs": {
        "meta": [
          "content"
        ],
        "script": [
          "src",
          "defer"
        ]
      },
      "h1_exact": 1
    },
    "hints": [
      "Телефон: <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">.",
      "Описание: <meta name=\"description\" content=\"...\">.",
      "Карточка: <meta property=\"og:title\" content=\"...\">.",
      "Стили: <link rel=\"stylesheet\" href=\"css/style.css\">.",
      "Скрипт: <script src=\"js/main.js\" defer></script> - с закрывающим тегом."
    ]
  },
