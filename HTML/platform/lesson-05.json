    "starter_code": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Расписание кружка</title>\n</head>\n<body>\n    <main>\n        <h1>Расписание кружка</h1>\n        <!-- Таблица 1: caption, thead (3 th scope=\"col\"), tbody (3 строки, первая ячейка th scope=\"row\") -->\n\n        <!-- Таблица 2: «Длинное занятие», одна ячейка с rowspan=\"2\" -->\n    </main>\n</body>\n</html>\n",
