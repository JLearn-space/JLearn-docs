{
  "lesson": 8,
  "language": "ru",
  "lesson_title": "Доступность (a11y)",
  "task": {
    "title": "Исправьте анкету: 6 ошибок доступности",
    "language": "html",
    "description": "В стартовом коде шесть ошибок доступности. Исправьте: div role=\"button\" - на button type=\"submit\"; подпись почты - через label for; ссылке-иконке - aria-label; уберите положительный tabindex; добавьте ссылку #main и id=\"main\" у main; «Частые вопросы» - через details и summary.",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Анкета участника</title>\n</head>\n<body>\n    <header>\n        <p>Кружок веб-разработки</p>\n        <a href=\"https://t.me/example\">\n            <img src=\"images/telegram.svg\" alt=\"\" width=\"24\">\n        </a>\n    </header>\n    <main>\n        <h1>Анкета участника</h1>\n        <form method=\"get\">\n            <p>\n                <label for=\"name\">Имя</label>\n                <input type=\"text\" id=\"name\" name=\"name\" required>\n            </p>\n            <p>\n                Почта\n                <input type=\"email\" id=\"email\" name=\"email\" tabindex=\"3\" required>\n            </p>\n            <div role=\"button\">Отправить</div>\n        </form>\n        <h2>Частые вопросы</h2>\n        <p><strong>Сколько стоит участие?</strong></p>\n        <p>Участие бесплатное.</p>\n    </main>\n</body>\n</html>\n",
    "rules": {
      "required": [
        "<!DOCTYPE html>",
        "<html lang=\"",
        "href=\"#main\"",
        "id=\"main\"",
        "<details",
        "<summary"
      ],
      "forbidden": [
        "role=\"button\"",
        "tabindex=\"1\"",
        "tabindex=\"2\"",
        "tabindex=\"3\"",
        "tabindex=\"4\"",
        "tabindex=\"5\""
      ],
      "tags": {
        "label": 2,
        "details": 1,
        "summary": 1
      },
      "for_id_pairs": true,
      "button_submit": true,
      "empty_link_a11y": true,
      "href_targets": [
        "#main"
      ],
      "h1_exact": 1
    },
    "hints": [
      "Кнопка: <button type=\"submit\">Отправить</button>.",
      "Подпись почты: <label for=\"email\">Почта</label>.",
      "Ссылка-иконка: <a href=\"...\" aria-label=\"Наш Telegram-канал\">.",
      "Положительный tabindex удалите целиком.",
      "Первой строкой body: <a href=\"#main\">Перейти к основному содержимому</a>, а у main - id=\"main\".",
      "Вопрос-ответ: <details><summary>Вопрос</summary><p>Ответ</p></details>."
    ]
  },
  "test": {
    "pass_percent": 70,
    "questions": [
      {
        "type": "single",
        "question": "Что означает «11» в a11y?",
