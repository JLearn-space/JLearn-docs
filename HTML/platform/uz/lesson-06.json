      "h1_exact": 1
    },
    "hints": [
      "Imzo: <label for=\"email\">Pochta</label> va <input id=\"email\" ...> maydoni.",
      "Majburiy maydon: required atributi.",
      "radio guruhi: ikkalasida bir xil name, turli value.",
      "Bu darsda tugma - <input type=\"submit\" value=\"Yozilish\">.",
      "Har bir for mavjud id bilan mos kelishini tekshiring."
    ]
  },
