    "hints": [
      "Belgi: <head> ichida <link rel=\"icon\" type=\"image/png\" href=\"favicon.png\">.",
      "Imzoli rasm: <figure><img ...><figcaption>...</figcaption></figure>.",
      "Bezak rasmi: alt=\"\".",
      "Video: <video controls><source src=\"video/....mp4\" type=\"video/mp4\"></video>.",
      "autoplay va alt=\"rasm\" kabi bo‘sh tavsiflarni ishlatmang."
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"uz\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Qiziqishlarim</title>\n    <link rel=\"icon\" type=\"image/png\" href=\"favicon.png\">\n</head>\n<body>\n    <main>\n        <h1>Qiziqishlarim</h1>\n        <p>Men tog‘larni va fotografiyani yaxshi ko‘raman.</p>\n        <figure>\n            <img src=\"images/mountains.jpg\" alt=\"Tong paytidagi Chimyonning qorli cho‘qqilari\" width=\"600\" height=\"400\">\n            <figcaption>Chimyon, o‘tgan qish</figcaption>\n        </figure>\n        <img src=\"images/divider.png\" alt=\"\" width=\"600\">\n        <img src=\"images/camera.jpg\" alt=\"Shtativdagi fotoapparatim\" width=\"300\" loading=\"lazy\">\n        <video controls width=\"640\" poster=\"images/video-preview.jpg\">\n            <source src=\"video/hike.mp4\" type=\"video/mp4\">\n        </video>\n        <p><a href=\"video/hike.mp4\">Videoni yuklab olish</a></p>\n    </main>\n</body>\n</html>",
