    "solution": "<!DOCTYPE html>\n<html lang=\"uz\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Ishtirokchi anketasi</title>\n</head>\n<body>\n    <main>\n        <h1>Ishtirokchi anketasi</h1>\n        <form method=\"get\">\n            <fieldset>\n                <legend>Shaxsiy ma’lumotlar</legend>\n                <p>\n                    <label for=\"student-id\">Talabalik guvohnomasi raqami (7 ta raqam)</label>\n                    <input type=\"text\" id=\"student-id\" name=\"student-id\" pattern=\"[0-9]{7}\" inputmode=\"numeric\" required>\n                </p>\n                <p>\n                    <label for=\"about\">O‘zim haqimda</label>\n                    <textarea id=\"about\" name=\"about\" rows=\"4\" maxlength=\"300\">Birinchi kursda o‘qiyman.</textarea>\n                </p>\n            </fieldset>\n            <fieldset>\n                <legend>Yo‘nalish</legend>\n                <p>\n                    <label for=\"course\">Nimani o‘rganmoqchisiz</label>\n                    <select id=\"course\" name=\"course\">\n                        <optgroup label=\"Frontend\">\n                            <option value=\"html\" selected>HTML</option>\n                            <option value=\"css\">CSS</option>\n                        </optgroup>\n                        <optgroup label=\"Backend\">\n                            <option value=\"php\">PHP</option>\n                            <option value=\"sql\">SQL</option>\n                        </optgroup>\n                    </select>\n                </p>\n            </fieldset>\n            <p>\n                <button type=\"submit\">Anketani yuborish</button>\n                <button type=\"reset\">Tozalash</button>\n            </p>\n        </form>\n    </main>\n</body>\n</html>",
