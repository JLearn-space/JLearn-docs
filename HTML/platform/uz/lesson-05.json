  "task": {
    "title": "To‘garak jadvali",
    "language": "html",
    "description": "Ikkita jadval yasang. Birinchisi: caption, uchta th scope=\"col\" li thead, kamida uch qatorli tbody, qatorning birinchi katagi - th scope=\"row\". Ikkinchisi: rowspan=\"2\" li bitta katakka ega «Uzun mashg‘ulot».",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"uz\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>To‘garak jadvali</title>\n</head>\n<body>\n    <main>\n        <h1>To‘garak jadvali</h1>\n        <!-- 1-jadval: caption, thead (3 ta th scope=\"col\"), tbody (3 qator, birinchi katak th scope=\"row\") -->\n\n        <!-- 2-jadval: «Uzun mashg‘ulot», rowspan=\"2\" li bitta katak -->\n    </main>\n</body>\n</html>\n",
    "rules": {
      "required": [
        "<!DOCTYPE html>",
        "<html lang=\"",
        "<meta charset=\"utf-8\"",
        "<title>",
        "<caption",
        "<thead",
        "<tbody",
        "rowspan=\""
      ],
