        "table": 2,
        "caption": 1,
        "tr": 7,
        "th": 6,
        "td": 6
      },
      "scope_values": [
        "col",
        "row"
      ],
      "h1_exact": 1
    },
    "hints": [
      "Jadval nomi: <table> dan keyin darhol <caption>.",
      "Sarlavha qatori: <thead><tr><th scope=\"col\">Kun</th>...</tr></thead>.",
      "Ma’lumot qatori: <tr><th scope=\"row\">Dushanba</th><td>15:00</td><td>HTML</td></tr>.",
      "Ikkinchi jadval: bitta <td rowspan=\"2\"> katak, keyingi qatorda bitta katak kam.",
      "Sarlavha - bu <td><strong> emas, <th>."
    ]
  },
