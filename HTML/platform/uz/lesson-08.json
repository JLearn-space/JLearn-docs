  "task": {
    "title": "Anketani tuzating: 6 ta qulaylik xatosi",
    "language": "html",
    "description": "Boshlang‘ich kodda oltita qulaylik xatosi bor. Tuzating: div role=\"button\" ni button type=\"submit\" ga; pochta imzosini label for orqali; belgi-havolaga aria-label; musbat tabindex ni olib tashlang; #main havolasi va main da id=\"main\" qo‘shing; «Ko‘p beriladigan savollar» ni details va summary orqali.",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"uz\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Ishtirokchi anketasi</title>\n</head>\n<body>\n    <header>\n        <p>Veb-dasturlash to‘garagi</p>\n        <a href=\"https://t.me/example\">\n            <img src=\"images/telegram.svg\" alt=\"\" width=\"24\">\n        </a>\n    </header>\n    <main>\n        <h1>Ishtirokchi anketasi</h1>\n        <form method=\"get\">\n            <p>\n                <label for=\"name\">Ism</label>\n                <input type=\"text\" id=\"name\" name=\"name\" required>\n            </p>\n            <p>\n                Pochta\n                <input type=\"email\" id=\"email\" name=\"email\" tabindex=\"3\" required>\n            </p>\n            <div role=\"button\">Yuborish</div>\n        </form>\n        <h2>Ko‘p beriladigan savollar</h2>\n        <p><strong>Qatnashish qancha turadi?</strong></p>\n        <p>Qatnashish bepul.</p>\n    </main>\n</body>\n</html>\n",
    "rules": {
      "required": [
        "<!DOCTYPE html>",
        "<html lang=\"",
        "href=\"#main\"",
        "id=\"main\"",
        "<details",
        "<summary"
      ],
      "forbidden": [
        "role=\"button\"",
        "tabindex=\"1\"",
        "tabindex=\"2\"",
        "tabindex=\"3\"",
        "tabindex=\"4\"",
        "tabindex=\"5\""
      ],
      "tags": {
        "label": 2,
        "details": 1,
        "summary": 1
      },
      "for_id_pairs": true,
      "button_submit": true,
      "empty_link_a11y": true,
      "href_targets": [
        "#main"
      ],
      "h1_exact": 1
    },
    "hints": [
      "Tugma: <button type=\"submit\">Yuborish</button>.",
      "Pochta imzosi: <label for=\"email\">Pochta</label>.",
      "Belgi-havola: <a href=\"...\" aria-label=\"Telegram kanalimiz\">.",
      "Musbat tabindex ni butunlay o‘chiring.",
      "body ning birinchi qatori: <a href=\"#main\">Asosiy mazmunga o‘tish</a>, main da esa - id=\"main\".",
      "Savol-javob: <details><summary>Savol</summary><p>Javob</p></details>."
    ]
  },
