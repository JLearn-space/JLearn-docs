    "starter_code": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Моя первая стилизация</title>\n    <!-- Добавьте сюда тег <style> -->\n</head>\n<body>\n    <h1>Кружок веб-разработки</h1>\n    <p>Учимся делать сайты с нуля.</p>\n    <h2>Расписание</h2>\n    <p>Каждую среду в 15:00.</p>\n</body>\n</html>\n",
