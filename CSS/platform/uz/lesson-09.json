  "lesson_title": "Holatlar, o‘tishlar, animatsiyalar va o‘zgaruvchilar",
  "task": {
    "title": "Jonli interfeys: holatlar va animatsiyalar",
    "language": "html",
    "description": "hero, btn, card, required-label sinflarini qo‘shing. <style> da: --primary va yana bitta o‘zgaruvchili :root, var(); outline li .btn:hover va .btn:focus-visible; .card:hover - translateY; @keyframes fade-in; content li .required-label::after. Barcha transition va .hero dagi animation: fade-in - @media (prefers-reduced-motion: no-preference) ichida. outline: none ni ishlatmang.",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"uz\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>To‘garak</title>\n    <!-- <style>: :root, .btn (:hover, :focus-visible), .card:hover, @keyframes, .hero, .required-label::after, prefers-reduced-motion -->\n</head>\n<body>\n    <section>\n        <h1>Veb-dasturlash to‘garagi</h1>\n        <a href=\"join.html\">Yozilish</a>\n    </section>\n    <main>\n        <article><h2>Kurs: HTML</h2><p>10 ta dars.</p></article>\n        <article><h2>Kurs: CSS</h2><p>10 ta dars.</p></article>\n        <form method=\"get\">\n            <label for=\"email\">Pochta</label>\n            <input type=\"email\" id=\"email\" name=\"email\" required>\n            <button type=\"submit\">Yuborish</button>\n        </form>\n    </main>\n</body>\n</html>",
    "rules": {
      "required": [
        ":root {",
        "--primary:",
        "var(--primary)",
        "transition:",
        ".btn:hover",
        ".btn:focus-visible",
        "outline:",
        "translateY(",
        "@keyframes fade-in",
        "animation: fade-in",
        "::after",
        "content:",
        "prefers-reduced-motion: no-preference",
        "class=\"hero\"",
        "class=\"btn\"",
        "class=\"card\"",
        "class=\"required-label\""
      ],
      "forbidden": [
        "outline: none",
        "outline: 0",
        "style=\""
      ],
      "for_id_pairs": true,
      "h1_exact": 1
    },
    "hints": [
      "O‘zgaruvchilar: :root { --primary: #1e3a8a; } va background-color: var(--primary);",
      "Fokus: .btn:focus-visible { outline: 3px solid #f59e0b; } - outline: none mumkin emas.",
      "Silliqlik: transition: background-color 0.2s ease; - oddiy holatda, no-preference ichida.",
      "Ko‘tarish: .card:hover { transform: translateY(-4px); }",
      "Animatsiya: @keyframes fade-in { from {...} to {...} }, .hero { animation: fade-in 0.6s; } esa - no-preference ichida.",
      "Yulduzcha: .required-label::after { content: \" *\"; }",
      "Harakat faqat qarshi bo‘lmaganlarga: @media (prefers-reduced-motion: no-preference) { ... }"
    ]
  },
