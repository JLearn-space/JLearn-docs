    "starter_code": "<!DOCTYPE html>\n<html lang=\"uz\">\n<head>\n    <meta charset=\"UTF-8\">\n    <!-- viewport -->\n    <title>Loyihalar</title>\n    <!-- <style>: img, h1, .site-header, .cards + @media (min-width: ...) -->\n</head>\n<body>\n    <header>\n        <p>Veb-dasturlash to‘garagi</p>\n        <nav><a href=\"index.html\">Bosh sahifa</a> <a href=\"join.html\">Yozilish</a></nav>\n    </header>\n    <main>\n        <h1>Ishtirokchilar loyihalari</h1>\n        <div>\n            <article><img src=\"images/1.jpg\" alt=\"Noutbukdagi portfolio sayti\" width=\"800\" height=\"500\"><h2>Portfolio</h2></article>\n            <article><img src=\"images/2.jpg\" alt=\"Telefondagi kafe menyusi\" width=\"800\" height=\"500\"><h2>Kafe</h2></article>\n            <article><img src=\"images/3.jpg\" alt=\"Kutubxona katalogi\" width=\"800\" height=\"500\"><h2>Kutubxona</h2></article>\n        </div>\n    </main>\n</body>\n</html>",
