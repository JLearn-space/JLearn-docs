    "hints": [
      "head da: <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "Elastik rasmlar: img { max-width: 100%; height: auto; }",
      "Asosiy uslublar - telefon uchun, keyin @media (min-width: 600px) { ... } va @media (min-width: 900px) { ... }.",
