    "hints": [
      "Maket: .page { display: grid; grid-template-areas: \"header header\" \"main aside\" \"footer footer\"; }",
      "Blok sohani egallaydi: .page-main { grid-area: main; } - qo‘shtirnoqsiz.",
      "Moslashuvchan galereya: grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));",
      "Ikki ustunga: .featured { grid-column: span 2; }"
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"uz\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Loyihalar galereyasi</title>\n    <style>\n        .page {\n            display: grid;\n            grid-template-columns: 1fr 260px;\n            grid-template-areas:\n                \"header header\"\n                \"main   aside\"\n                \"footer footer\";\n            gap: 16px;\n        }\n\n        .page-header {\n            grid-area: header;\n        }\n\n        .page-main {\n            grid-area: main;\n        }\n\n        .page-aside {\n            grid-area: aside;\n        }\n\n        .page-footer {\n            grid-area: footer;\n        }\n\n        .gallery {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 16px;\n        }\n\n        .featured {\n            grid-column: span 2;\n        }\n    </style>\n</head>\n<body class=\"page\">\n    <header class=\"page-header\">\n        <p>Veb-dasturlash to‘garagi</p>\n    </header>\n    <main class=\"page-main\">\n        <h1>Loyihalar galereyasi</h1>\n        <div class=\"gallery\">\n            <img class=\"featured\" src=\"images/1.jpg\" alt=\"Noutbukdagi portfolio sayti\" width=\"400\" height=\"250\">\n            <img src=\"images/2.jpg\" alt=\"Telefondagi kafe menyusi\" width=\"200\" height=\"250\">\n            <img src=\"images/3.jpg\" alt=\"Kutubxona katalogi\" width=\"200\" height=\"250\">\n            <img src=\"images/4.jpg\" alt=\"To‘garakka yozilish formasi\" width=\"200\" height=\"250\">\n        </div>\n    </main>\n    <aside class=\"page-aside\">\n        <h2>Yaqin mashg‘ulotlar</h2>\n        <p>Chorshanba, 15:00.</p>\n    </aside>\n    <footer class=\"page-footer\">\n        <p>&copy; 2026 To‘garak</p>\n    </footer>\n</body>\n</html>",
