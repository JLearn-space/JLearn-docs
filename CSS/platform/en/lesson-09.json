{
  "lesson": 9,
  "language": "en",
  "lesson_title": "States, transitions, animations and variables",
  "task": {
    "title": "A lively interface: states and animations",
    "language": "html",
    "description": "Add the classes hero, btn, card, required-label. In <style>: :root with --primary and one more variable, var(); .btn:hover and .btn:focus-visible with outline; .card:hover - translateY; @keyframes fade-in; .required-label::after with content. All transition and the animation: fade-in on .hero go inside @media (prefers-reduced-motion: no-preference). Do not use outline: none.",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Club</title>\n    <!-- <style>: :root, .btn (:hover, :focus-visible), .card:hover, @keyframes, .hero, .required-label::after, prefers-reduced-motion -->\n</head>\n<body>\n    <section>\n        <h1>Web development club</h1>\n        <a href=\"join.html\">Sign up</a>\n    </section>\n    <main>\n        <article><h2>Course: HTML</h2><p>10 lessons.</p></article>\n        <article><h2>Course: CSS</h2><p>10 lessons.</p></article>\n        <form method=\"get\">\n            <label for=\"email\">Email</label>\n            <input type=\"email\" id=\"email\" name=\"email\" required>\n            <button type=\"submit\">Submit</button>\n        </form>\n    </main>\n</body>\n</html>",
    "rules": {
      "required": [
        ":root {",
        "--primary:",
        "var(--primary)",
        "transition:",
        ".btn:hover",
        ".btn:focus-visible",
        "outline:",
        "translateY(",
        "@keyframes fade-in",
        "animation: fade-in",
        "::after",
        "content:",
        "prefers-reduced-motion: no-preference",
        "class=\"hero\"",
        "class=\"btn\"",
        "class=\"card\"",
        "class=\"required-label\""
      ],
      "forbidden": [
        "outline: none",
        "outline: 0",
        "style=\""
      ],
      "for_id_pairs": true,
      "h1_exact": 1
    },
    "hints": [
      "Variables: :root { --primary: #1e3a8a; } and background-color: var(--primary);",
      "Focus: .btn:focus-visible { outline: 3px solid #f59e0b; } - outline: none is not allowed.",
      "Smoothness: transition: background-color 0.2s ease; - on the normal state, inside no-preference.",
      "Lift: .card:hover { transform: translateY(-4px); }",
      "Animation: @keyframes fade-in { from {...} to {...} }, and .hero { animation: fade-in 0.6s; } goes inside no-preference.",
      "Asterisk: .required-label::after { content: \" *\"; }",
      "Motion only for those who do not mind: @media (prefers-reduced-motion: no-preference) { ... }"
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Club</title>\n    <style>\n        :root {\n            --primary: #1e3a8a;\n            --primary-dark: #172554;\n            --radius: 12px;\n        }\n\n        .btn {\n            background-color: var(--primary);\n            color: white;\n            border-radius: var(--radius);\n        }\n\n        .btn:hover {\n            background-color: var(--primary-dark);\n        }\n\n        .btn:focus-visible {\n            outline: 3px solid #f59e0b;\n            outline-offset: 2px;\n        }\n\n        .card:hover {\n            transform: translateY(-4px);\n        }\n\n        @keyframes fade-in {\n            from {\n                opacity: 0;\n            }\n\n            to {\n                opacity: 1;\n            }\n        }\n\n        .required-label::after {\n            content: \" *\";\n            color: #b91c1c;\n        }\n\n        @media (prefers-reduced-motion: no-preference) {\n            .btn {\n                transition: background-color 0.2s ease;\n            }\n\n            .card {\n                transition: transform 0.2s ease;\n            }\n\n            .hero {\n                animation: fade-in 0.6s ease-out;\n            }\n        }\n    </style>\n</head>\n<body>\n    <section class=\"hero\">\n        <h1>Web development club</h1>\n        <a href=\"join.html\" class=\"btn\">Sign up</a>\n    </section>\n    <main>\n        <article class=\"card\"><h2>Course: HTML</h2><p>10 lessons.</p></article>\n        <article class=\"card\"><h2>Course: CSS</h2><p>10 lessons.</p></article>\n        <form method=\"get\">\n            <label class=\"required-label\" for=\"email\">Email</label>\n            <input type=\"email\" id=\"email\" name=\"email\" required>\n            <button type=\"submit\" class=\"btn\">Submit</button>\n        </form>\n    </main>\n</body>\n</html>",
