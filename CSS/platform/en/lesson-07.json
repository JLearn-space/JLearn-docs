      {
        "type": "single",
        "question": "What position value do elements have by default?",
        "options": [
          "relative",
          "static",
          "absolute",
          "block"
        ],
        "answer": 1,
        "explanation": "static is the normal flow."
      },
      {
        "type": "single",
        "question": "What is position: absolute measured from?",
        "options": [
          "Always from the browser window",
          "From the nearest ancestor whose position is not static",
          "From its own normal place",
          "Always from body"
        ],
        "answer": 1,
        "explanation": "If there is no such ancestor - from the page."
      },
      {
