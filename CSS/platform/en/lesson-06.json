    "hints": [
      "Layout: .page { display: grid; grid-template-areas: \"header header\" \"main aside\" \"footer footer\"; }",
      "A block takes an area: .page-main { grid-area: main; } - no quotes.",
      "Responsive gallery: grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));",
      "Across two columns: .featured { grid-column: span 2; }"
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Project gallery</title>\n    <style>\n        .page {\n            display: grid;\n            grid-template-columns: 1fr 260px;\n            grid-template-areas:\n                \"header header\"\n                \"main   aside\"\n                \"footer footer\";\n            gap: 16px;\n        }\n\n        .page-header {\n            grid-area: header;\n        }\n\n        .page-main {\n            grid-area: main;\n        }\n\n        .page-aside {\n            grid-area: aside;\n        }\n\n        .page-footer {\n            grid-area: footer;\n        }\n\n        .gallery {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 16px;\n        }\n\n        .featured {\n            grid-column: span 2;\n        }\n    </style>\n</head>\n<body class=\"page\">\n    <header class=\"page-header\">\n        <p>Web development club</p>\n    </header>\n    <main class=\"page-main\">\n        <h1>Project gallery</h1>\n        <div class=\"gallery\">\n            <img class=\"featured\" src=\"images/1.jpg\" alt=\"A portfolio site on a laptop\" width=\"400\" height=\"250\">\n            <img src=\"images/2.jpg\" alt=\"A café menu on a phone\" width=\"200\" height=\"250\">\n            <img src=\"images/3.jpg\" alt=\"A library catalog\" width=\"200\" height=\"250\">\n            <img src=\"images/4.jpg\" alt=\"A club sign-up form\" width=\"200\" height=\"250\">\n        </div>\n    </main>\n    <aside class=\"page-aside\">\n        <h2>Upcoming classes</h2>\n        <p>Wednesday, 15:00.</p>\n    </aside>\n    <footer class=\"page-footer\">\n        <p>&copy; 2026 Club</p>\n    </footer>\n</body>\n</html>",
