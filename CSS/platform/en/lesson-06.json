  "task": {
    "title": "A page layout and a gallery with Grid",
    "language": "html",
    "description": "Add the classes. .page - display: grid with grid-template-areas (header, main, aside, footer); each block gets a grid-area; .gallery - repeat(auto-fit, minmax(..., 1fr)) and gap; .featured - grid-column: span 2. No float and no style=\"\".",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Project gallery</title>\n    <!-- <style>: .page (grid-template-areas), areas, .gallery, .featured -->\n</head>\n<body>\n    <header>\n        <p>Web development club</p>\n    </header>\n    <main>\n        <h1>Project gallery</h1>\n        <div>\n            <img src=\"images/1.jpg\" alt=\"A portfolio site on a laptop\" width=\"400\" height=\"250\">\n            <img src=\"images/2.jpg\" alt=\"A café menu on a phone\" width=\"200\" height=\"250\">\n            <img src=\"images/3.jpg\" alt=\"A library catalog\" width=\"200\" height=\"250\">\n            <img src=\"images/4.jpg\" alt=\"A club sign-up form\" width=\"200\" height=\"250\">\n        </div>\n    </main>\n    <aside>\n        <h2>Upcoming classes</h2>\n        <p>Wednesday, 15:00.</p>\n    </aside>\n    <footer>\n        <p>&copy; 2026 Club</p>\n    </footer>\n</body>\n</html>",
    "rules": {
      "required": [
        "<style>",
        "class=\"page\"",
        "class=\"gallery\"",
        "class=\"featured\"",
        ".page {",
        ".gallery {",
        ".featured {",
        "display: grid;",
        "grid-template-areas:",
        "grid-area: header;",
        "grid-area: main;",
        "grid-area: aside;",
        "grid-area: footer;",
        "repeat(auto-fit",
        "minmax(",
        "1fr",
        "gap:",
        "span 2"
      ],
      "forbidden": [
        "float:",
        "style=\"",
        "grid-area: \""
      ],
