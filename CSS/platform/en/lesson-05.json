  "task": {
    "title": "A header and a row of cards with Flexbox",
    "language": "html",
    "description": "Add the classes site-header, menu, cards, card. .site-header - flex, space-between, align-items: center; .menu - flex, gap, list-style: none; .cards - flex, flex-wrap: wrap, gap; .card - flex with three values. No float and no style=\"\".",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Club projects</title>\n    <!-- <style>: .site-header, .menu, .cards, .card -->\n</head>\n<body>\n    <header>\n        <p>Club</p>\n        <nav>\n            <ul>\n                <li><a href=\"index.html\">Home</a></li>\n                <li><a href=\"news.html\">News</a></li>\n                <li><a href=\"join.html\">Sign-up</a></li>\n            </ul>\n        </nav>\n    </header>\n    <main>\n        <h1>Members' projects</h1>\n        <div>\n            <article><h2>Portfolio</h2><p>A four-page site.</p></article>\n            <article><h2>Café</h2><p>A menu and an order form.</p></article>\n            <article><h2>Library</h2><p>A catalog and a schedule.</p></article>\n        </div>\n    </main>\n</body>\n</html>",
    "rules": {
      "required": [
        "<style>",
        "class=\"site-header\"",
        "class=\"menu\"",
        "class=\"cards\"",
        "class=\"card\"",
        ".site-header {",
        ".menu {",
        ".cards {",
        ".card {",
        "display: flex;",
        "justify-content: space-between;",
        "align-items: center;",
        "gap:",
        "flex-wrap: wrap;",
        "flex: 1",
        "list-style: none;"
      ],
      "forbidden": [
        "float:",
        "style=\""
      ],
      "tags": {
        "article": 3
      },
      "h1_exact": 1
    },
    "hints": [
      "Header: .site-header { display: flex; justify-content: space-between; align-items: center; }",
      "Menu: .menu { display: flex; gap: 16px; list-style: none; }",
      "Row of cards: .cards { display: flex; flex-wrap: wrap; gap: 24px; }",
      "Card: .card { flex: 1 1 240px; }",
      "Do not use float or style=\"\"."
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Club projects</title>\n    <style>\n        .site-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .menu {\n            display: flex;\n            gap: 16px;\n            list-style: none;\n        }\n\n        .cards {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 24px;\n        }\n\n        .card {\n            flex: 1 1 240px;\n        }\n    </style>\n</head>\n<body>\n    <header class=\"site-header\">\n        <p>Club</p>\n        <nav>\n            <ul class=\"menu\">\n                <li><a href=\"index.html\">Home</a></li>\n                <li><a href=\"news.html\">News</a></li>\n                <li><a href=\"join.html\">Sign-up</a></li>\n            </ul>\n        </nav>\n    </header>\n    <main>\n        <h1>Members' projects</h1>\n        <div class=\"cards\">\n            <article class=\"card\"><h2>Portfolio</h2><p>A four-page site.</p></article>\n            <article class=\"card\"><h2>Café</h2><p>A menu and an order form.</p></article>\n            <article class=\"card\"><h2>Library</h2><p>A catalog and a schedule.</p></article>\n        </div>\n    </main>\n</body>\n</html>",
