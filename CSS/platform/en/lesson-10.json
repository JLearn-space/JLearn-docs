  "task": {
    "title": "Styling the contacts page of your own site",
    "language": "html",
    "description": "Style the page in <style>: :root with variables and var(); * box-sizing; img max-width: 100%; main max-width and margin: 0 auto; body > header - sticky, flex, column, row from 600px; table border-collapse; input width: 100% and font: inherit; :focus-visible with outline; a dark theme via prefers-color-scheme: dark; motion only in prefers-reduced-motion: no-preference.",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Contacts - Rook Chess Club</title>\n    <!-- <style>: variables, base, header, table, form, focus, responsiveness, dark theme, motion -->\n</head>\n<body>\n    <header>\n        <p>Rook Chess Club</p>\n        <nav>\n            <ul>\n                <li><a href=\"index.html\">Home</a></li>\n                <li><a href=\"contact.html\">Contacts</a></li>\n            </ul>\n        </nav>\n    </header>\n    <main>\n        <h1>Contacts</h1>\n        <table>\n            <caption>Opening hours</caption>\n            <tr><th scope=\"col\">Day</th><th scope=\"col\">Time</th></tr>\n            <tr><th scope=\"row\">Tuesday</th><td>16:00-19:00</td></tr>\n        </table>\n        <form method=\"get\">\n            <label for=\"name\">Name</label>\n            <input type=\"text\" id=\"name\" name=\"name\" required>\n            <button type=\"submit\">Sign up</button>\n        </form>\n    </main>\n</body>\n</html>",
    "rules": {
      "required": [
        "<style>",
        ":root {",
        "var(--",
        "box-sizing: border-box;",
        "max-width: 100%;",
        "margin: 0 auto;",
        "body > header",
        "position: sticky;",
        "display: flex;",
        "flex-direction: column;",
        "flex-direction: row;",
        "@media (min-width: 600px)",
        "border-collapse: collapse;",
        "width: 100%;",
        "font: inherit;",
        ":focus-visible",
        "outline:",
        "prefers-color-scheme: dark",
        "prefers-reduced-motion: no-preference"
      ],
      "forbidden": [
        "!important",
        "outline: none",
        "outline: 0",
        "@media (max-width",
        "style=\"",
        "Азиз",
        "aziz"
      ],
      "for_id_pairs": true,
      "scope_values": [
        "col",
        "row"
      ],
      "button_submit": true,
      "h1_exact": 1
    },
    "hints": [
      "Variables: :root { --primary: ...; } and color: var(--primary);",
      "Site header: body > header { position: sticky; top: 0; display: flex; flex-direction: column; }",
      "From 600px: @media (min-width: 600px) { body > header { flex-direction: row; } }",
      "Table: border-collapse: collapse; fields: width: 100%; font: inherit;",
      "Focus: input:focus-visible, button:focus-visible { outline: 3px solid ...; }",
      "Dark theme: @media (prefers-color-scheme: dark) { :root { ... } }",
      "Motion: @media (prefers-reduced-motion: no-preference) { transition ... }"
    ]
  },
