{
  "lesson": 10,
  "language": "ru",
  "lesson_title": "Итоговый проект",
  "task": {
    "title": "Оформление страницы контактов своего сайта",
    "language": "html",
    "description": "Оформите страницу в <style>: :root с переменными и var(); * box-sizing; img max-width: 100%; main max-width и margin: 0 auto; body > header - sticky, flex, column, от 600px row; таблица border-collapse; input width: 100% и font: inherit; :focus-visible с outline; тёмная тема через prefers-color-scheme: dark; движение только в prefers-reduced-motion: no-preference.",
    "starter_code": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Контакты - Шахматный клуб «Ладья»</title>\n    <!-- <style>: переменные, основа, шапка, таблица, форма, фокус, адаптивность, тёмная тема, движение -->\n</head>\n<body>\n    <header>\n        <p>Шахматный клуб «Ладья»</p>\n        <nav>\n            <ul>\n                <li><a href=\"index.html\">Главная</a></li>\n                <li><a href=\"contact.html\">Контакты</a></li>\n            </ul>\n        </nav>\n    </header>\n    <main>\n        <h1>Контакты</h1>\n        <table>\n            <caption>Часы работы</caption>\n            <tr><th scope=\"col\">День</th><th scope=\"col\">Время</th></tr>\n            <tr><th scope=\"row\">Вторник</th><td>16:00-19:00</td></tr>\n        </table>\n        <form method=\"get\">\n            <label for=\"name\">Имя</label>\n            <input type=\"text\" id=\"name\" name=\"name\" required>\n            <button type=\"submit\">Записаться</button>\n        </form>\n    </main>\n</body>\n</html>",
    "rules": {
      "required": [
        "<style>",
        ":root {",
        "var(--",
        "box-sizing: border-box;",
        "max-width: 100%;",
        "margin: 0 auto;",
        "body > header",
        "position: sticky;",
        "display: flex;",
        "flex-direction: column;",
        "flex-direction: row;",
        "@media (min-width: 600px)",
        "border-collapse: collapse;",
        "width: 100%;",
        "font: inherit;",
        ":focus-visible",
        "outline:",
        "prefers-color-scheme: dark",
        "prefers-reduced-motion: no-preference"
      ],
      "forbidden": [
        "!important",
        "outline: none",
        "outline: 0",
        "@media (max-width",
        "style=\"",
        "Азиз"
      ],
      "for_id_pairs": true,
      "scope_values": [
        "col",
        "row"
      ],
      "button_submit": true,
      "h1_exact": 1
    },
    "hints": [
      "Переменные: :root { --primary: ...; } и color: var(--primary);",
      "Шапка сайта: body > header { position: sticky; top: 0; display: flex; flex-direction: column; }",
      "От 600px: @media (min-width: 600px) { body > header { flex-direction: row; } }",
      "Таблица: border-collapse: collapse; поля: width: 100%; font: inherit;",
      "Фокус: input:focus-visible, button:focus-visible { outline: 3px solid ...; }",
      "Тёмная тема: @media (prefers-color-scheme: dark) { :root { ... } }",
      "Движение: @media (prefers-reduced-motion: no-preference) { transition ... }"
    ],
    "solution": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Контакты - Шахматный клуб «Ладья»</title>\n    <style>\n        :root {\n            --primary: #14532d;\n            --bg: #f7f7f2;\n            --text: #1c1917;\n            --accent: #ea580c;\n        }\n\n        * {\n            box-sizing: border-box;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n        }\n\n        body {\n            margin: 0;\n            font-family: Georgia, serif;\n            line-height: 1.6;\n            color: var(--text);\n            background-color: var(--bg);\n        }\n\n        main {\n            max-width: 720px;\n            margin: 0 auto;\n            padding: 16px;\n        }\n\n        body > header {\n            position: sticky;\n            top: 0;\n            display: flex;\n            flex-direction: column;\n            background-color: var(--bg);\n        }\n\n        table {\n            width: 100%;\n            border-collapse: collapse;\n        }\n\n        input {\n            width: 100%;\n            font: inherit;\n        }\n\n        button {\n            background-color: var(--primary);\n            color: white;\n            font: inherit;\n        }\n\n        input:focus-visible, button:focus-visible {\n            outline: 3px solid var(--accent);\n        }\n\n        @media (min-width: 600px) {\n            body > header {\n                flex-direction: row;\n                justify-content: space-between;\n            }\n        }\n\n        @media (prefers-color-scheme: dark) {\n            :root {\n                --bg: #1c1917;\n                --text: #f5f5f4;\n            }\n        }\n\n        @media (prefers-reduced-motion: no-preference) {\n            button {\n                transition: background-color 0.2s ease;\n            }\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <p>Шахматный клуб «Ладья»</p>\n        <nav>\n            <ul>\n                <li><a href=\"index.html\">Главная</a></li>\n                <li><a href=\"contact.html\">Контакты</a></li>\n            </ul>\n        </nav>\n    </header>\n    <main>\n        <h1>Контакты</h1>\n        <table>\n            <caption>Часы работы</caption>\n            <tr><th scope=\"col\">День</th><th scope=\"col\">Время</th></tr>\n            <tr><th scope=\"row\">Вторник</th><td>16:00-19:00</td></tr>\n        </table>\n        <form method=\"get\">\n            <label for=\"name\">Имя</label>\n            <input type=\"text\" id=\"name\" name=\"name\" required>\n            <button type=\"submit\">Записаться</button>\n        </form>\n    </main>\n</body>\n</html>",
